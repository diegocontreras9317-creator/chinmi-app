rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && (request.auth.uid == userId || request.auth.uid == 'usr-google-' + userId);
    }

    match /users/{userId} {
      allow read, write: if true;

      match /mesas/{tableId} {
        allow read, write, create, update: if true;
        allow delete: if true;
      }

      match /menu/{menuId} {
        allow read: if true;
        allow write: if true;
      }

      match /productos/{productId} {
        allow read: if true;
        allow write: if true;
      }

      match /inventario/{itemId} {
        allow read, write: if true;
      }

      match /pedidos/{pedidoId} {
        allow read, write, create, update: if true;
        allow delete: if true;
      }

      match /ventas/{saleId} {
        allow read, write, create: if true;
        allow delete: if true;
      }

      match /empleados/{empleadoId} {
        allow read, write: if true;
      }
    }

    match /codigos_promocionales/{codigoId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
