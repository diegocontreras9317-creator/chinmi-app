rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && (request.auth.uid == userId || request.auth.uid == 'usr-google-' + userId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || request.auth != null;

      match /tables/{tableId} {
        allow read: if true;
        allow create, delete: if isOwner(userId) || request.auth != null;
        allow update: if true; // Allows customers ordering via QR
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner(userId) || request.auth != null;
      }

      match /perishables/{perishableId} {
        allow read, write: if isOwner(userId) || request.auth != null;
      }

      match /sales/{saleId} {
        allow read, write: if isOwner(userId) || request.auth != null;
      }

      match /data/{document=**} {
        allow read, write: if isOwner(userId) || request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
