rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && (request.auth.uid == userId || request.auth.uid == 'usr-google-' + userId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || request.auth != null;

      match /mesas/{tableId} {
        allow read, write, create, update: if true;
        allow delete: if isOwner(userId) || request.auth != null;
      }

      match /menu/{menuId} {
        allow read: if true;
        allow write: if isOwner(userId) || request.auth != null;
      }

      match /productos/{productId} {
        allow read: if true;
        allow write: if isOwner(userId) || request.auth != null;
      }

      match /inventario/{itemId} {
        allow read, write: if isOwner(userId) || request.auth != null;
      }

      match /pedidos/{pedidoId} {
        allow read, write, create, update: if true;
        allow delete: if isOwner(userId) || request.auth != null;
      }

      match /ventas/{saleId} {
        allow read, write, create: if true;
        allow delete: if isOwner(userId) || request.auth != null;
      }

      match /empleados/{empleadoId} {
        allow read, write: if isOwner(userId) || request.auth != null;
      }
    }

    match /codigos_promocionales/{codigoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
