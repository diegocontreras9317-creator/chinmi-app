{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Perfil de usuario registrado y su configuración",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "plan": { "type": "string" },
        "billingFrequency": { "type": "string" },
        "planExpiresAt": { "type": "string" },
        "businessName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Table": {
      "title": "Table",
      "description": "Entidad de mesa en el restaurante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "zone": { "type": "string" },
        "seats": { "type": "number" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "order": { "type": "object" },
        "waiterCall": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "number", "name", "zone", "seats", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Entidad de producto/plato del menú",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "taxType": { "type": "string" },
        "taxRate": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "stock"]
    },
    "PerishableItem": {
      "title": "PerishableItem",
      "description": "Entidad de insumo/inventario fresco",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minStock": { "type": "number" },
        "entryDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "location": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplier": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "batchNumber": { "type": "string" },
        "costPerUnit": { "type": "number" },
        "imageUrl": { "type": "string" },
        "notes": { "type": "string" },
        "alarmDaysBeforeExpiry": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "category", "quantity", "unit"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Proveedor de despensa e insumos registrado manualmente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "hasWhatsapp": { "type": "boolean" },
        "suppliesProvided": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "phone", "suppliesProvided"]
    },
    "SupplierOrder": {
      "title": "SupplierOrder",
      "description": "Registro de pedido realizado a un distribuidor con fecha, hora y confirmación de entrega completa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "channel": { "type": "string" },
        "businessName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "notes": { "type": "string" },
        "orderedAt": { "type": "string" },
        "status": { "type": "string" },
        "arrived": { "type": "boolean" },
        "arrivedComplete": { "type": "boolean" },
        "confirmedAt": { "type": "string" },
        "confirmedBy": { "type": "string" },
        "receptionNotes": { "type": "string" },
        "stockUpdated": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["id", "supplierName", "orderedAt", "status", "arrived", "arrivedComplete"]
    },
    "SaleReceipt": {
      "title": "SaleReceipt",
      "description": "Entidad de recibo o comprobante de venta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "tableName": { "type": "string" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "taxPercent": { "type": "number" },
        "ivaAmount": { "type": "number" },
        "impoconsumoAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "discountPercent": { "type": "number" },
        "tipAmount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "timestamp": { "type": "string" },
        "cashierName": { "type": "string" },
        "cashierRole": { "type": "string" },
        "cashierId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerDocumentType": { "type": "string" },
        "customerDocumentNumber": { "type": "string" },
        "customerEmail": { "type": "string" },
        "requiresElectronicInvoice": { "type": "boolean" },
        "electronicInvoiceStatus": { "type": "string" },
        "electronicInvoiceIssuedAt": { "type": "string" },
        "billingInfo": { "type": "object" },
        "userId": { "type": "string" }
      },
      "required": ["id", "total", "paymentMethod", "timestamp"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Código promocional o cupón de regalo para días PRO",
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "dias_premium": { "type": "number" },
        "activo": { "type": "boolean" },
        "descripcion": { "type": "string" }
      },
      "required": ["activo", "dias_premium"]
    }
  },
  "firestore": {
    "/codigos_promocionales/{codigoId}": {
      "schema": "#/entities/PromoCode",
      "description": "Colección de códigos promocionales canjeables"
    },
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Documento de perfil de usuario"
    },
    "/users/{userId}/mesas/{tableId}": {
      "schema": "#/entities/Table",
      "description": "Colección aislada de mesas del usuario"
    },
    "/users/{userId}/menu/{menuId}": {
      "schema": "#/entities/Product",
      "description": "Colección aislada del menú del usuario"
    },
    "/users/{userId}/productos/{productId}": {
      "schema": "#/entities/Product",
      "description": "Colección aislada de productos del usuario"
    },
    "/users/{userId}/inventario/{itemId}": {
      "schema": "#/entities/PerishableItem",
      "description": "Colección aislada de inventario/insumos del usuario"
    },
    "/users/{userId}/proveedores/{proveedorId}": {
      "schema": "#/entities/Supplier",
      "description": "Colección aislada de proveedores de insumos del usuario"
    },
    "/users/{userId}/ordenes_proveedores/{ordenId}": {
      "schema": "#/entities/SupplierOrder",
      "description": "Registro histórico de pedidos realizados a distribuidores y su confirmación de llegada"
    },
    "/users/{userId}/pedidos/{pedidoId}": {
      "schema": "#/entities/SaleReceipt",
      "description": "Colección aislada de pedidos del usuario"
    },
    "/users/{userId}/ventas/{saleId}": {
      "schema": "#/entities/SaleReceipt",
      "description": "Colección aislada de ventas del usuario"
    }
  }
}
