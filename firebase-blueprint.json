{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Perfil de usuario registrado y su configuración",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "plan": { "type": "string" },
        "billingFrequency": { "type": "string" },
        "planExpiresAt": { "type": "string" },
        "businessName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Table": {
      "title": "Table",
      "description": "Entidad de mesa en el restaurante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "zone": { "type": "string" },
        "seats": { "type": "number" },
        "status": { "type": "string" },
        "tableSessionId": { "type": "string" },
        "subaccounts": { "type": "array" },
        "userId": { "type": "string" },
        "order": { "type": "object" },
        "waiterCall": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "number", "name", "zone", "seats", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Entidad de producto/plato del menú",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "taxType": { "type": "string" },
        "taxRate": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "stock"]
    },
    "PerishableItem": {
      "title": "PerishableItem",
      "description": "Entidad de insumo/inventario fresco",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minStock": { "type": "number" },
        "entryDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "location": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplier": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "batchNumber": { "type": "string" },
        "costPerUnit": { "type": "number" },
        "imageUrl": { "type": "string" },
        "notes": { "type": "string" },
        "alarmDaysBeforeExpiry": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "category", "quantity", "unit"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Proveedor de despensa e insumos registrado manualmente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "hasWhatsapp": { "type": "boolean" },
        "suppliesProvided": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "phone", "suppliesProvided"]
    },
    "SupplierOrder": {
      "title": "SupplierOrder",
      "description": "Registro de pedido realizado a un distribuidor con fecha, hora y confirmación de entrega completa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "channel": { "type": "string" },
        "businessName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "notes": { "type": "string" },
        "orderedAt": { "type": "string" },
        "status": { "type": "string" },
        "arrived": { "type": "boolean" },
        "arrivedComplete": { "type": "boolean" },
        "confirmedAt": { "type": "string" },
        "confirmedBy": { "type": "string" },
        "receptionNotes": { "type": "string" },
        "stockUpdated": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["id", "supplierName", "orderedAt", "status", "arrived", "arrivedComplete"]
    },
    "SaleReceipt": {
      "title": "SaleReceipt",
      "description": "Entidad de recibo o comprobante de venta inmutable",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "tableName": { "type": "string" },
        "tableSessionId": { "type": "string" },
        "subaccountIds": { "type": "array" },
        "subaccountNames": { "type": "array" },
        "isPartialTableCheckout": { "type": "boolean" },
        "paymentOperationId": { "type": "string" },
        "paymentBreakdown": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "taxPercent": { "type": "number" },
        "ivaAmount": { "type": "number" },
        "impoconsumoAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "discountPercent": { "type": "number" },
        "tipAmount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "timestamp": { "type": "string" },
        "cashierName": { "type": "string" },
        "cashierRole": { "type": "string" },
        "cashierId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerDocumentType": { "type": "string" },
        "customerDocumentNumber": { "type": "string" },
        "customerEmail": { "type": "string" },
        "requiresElectronicInvoice": { "type": "boolean" },
        "electronicInvoiceStatus": { "type": "string" },
        "electronicInvoiceIssuedAt": { "type": "string" },
        "billingInfo": { "type": "object" },
        "userId": { "type": "string" }
      },
      "required": ["id", "total", "paymentMethod", "timestamp"]
    },
    "TablePaymentRecord": {
      "title": "TablePaymentRecord",
      "description": "Registro idempotente de pago parcial o total por mesa y subcuentas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "tableId": { "type": "string" },
        "tableName": { "type": "string" },
        "tableSessionId": { "type": "string" },
        "receiptId": { "type": "string" },
        "subaccountIds": { "type": "array" },
        "subaccountNames": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "ivaAmount": { "type": "number" },
        "impoconsumoAmount": { "type": "number" },
        "tipAmount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentBreakdown": { "type": "array" },
        "cashierName": { "type": "string" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "orderId", "tableId", "total", "createdAt", "userId"]
    },
    "PrivateQrBillingRecord": {
      "title": "PrivateQrBillingRecord",
      "description": "Buzón privado aislado de solicitudes fiscales QR (PII legible solo por el restaurante propietario)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tableId": { "type": "string" },
        "tableSessionId": { "type": "string" },
        "subaccountId": { "type": "string" },
        "subaccountName": { "type": "string" },
        "requiresElectronicInvoice": { "type": "boolean" },
        "billingInfo": { "type": "object" },
        "requestedTipAmount": { "type": "number" },
        "preferredPaymentMethod": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "tableId", "tableSessionId", "subaccountId", "requiresElectronicInvoice", "billingInfo"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Configuración visual, menú QR, subcuentas y parámetros del restaurante",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "businessPhone": { "type": "string" },
        "businessTaxId": { "type": "string" },
        "logoUrl": { "type": "string" },
        "categories": { "type": "array" },
        "qrSettings": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "SaleBillingMetadata": {
      "title": "SaleBillingMetadata",
      "description": "Metadatos contables de exportación y estado DIAN por venta",
      "type": "object",
      "properties": {
        "saleId": { "type": "string" },
        "billingStatus": { "type": "string" },
        "externalInvoiceNumber": { "type": "string" },
        "cufe": { "type": "string" },
        "exportPlatform": { "type": "string" },
        "exportedAt": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["saleId"]
    },
    "RestaurantFiscalProfile": {
      "title": "RestaurantFiscalProfile",
      "description": "Perfil fiscal y tributario del restaurante para exportaciones contables",
      "type": "object",
      "properties": {
        "nit": { "type": "string" },
        "dv": { "type": "string" },
        "businessName": { "type": "string" },
        "taxRegime": { "type": "string" },
        "cityCode": { "type": "string" },
        "cityName": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Código promocional o cupón de regalo para días PRO",
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "dias_premium": { "type": "number" },
        "activo": { "type": "boolean" },
        "descripcion": { "type": "string" }
      },
      "required": ["activo", "dias_premium"]
    },
    "Empleado": {
      "title": "Empleado",
      "description": "Perfil operativo y administrativo unificado de empleado del restaurante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "rol": { "type": "string" },
        "email": { "type": "string" },
        "activo": { "type": "boolean" },
        "pin": { "type": "string" },
        "avatarColor": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" },
        "authUid": { "type": "string" }
      },
      "required": ["id", "nombre", "rol", "activo"]
    }
  },
  "firestore": {
    "/codigos_promocionales/{codigoId}": {
      "schema": "#/entities/PromoCode",
      "description": "Colección de códigos promocionales canjeables"
    },
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Documento de perfil de usuario"
    },
    "/users/{userId}/config/{configId}": {
      "schema": "#/entities/AppConfig",
      "description": "Configuración del restaurante y carta QR del inquilino"
    },
    "/users/{userId}/config_fiscal/{configId}": {
      "schema": "#/entities/RestaurantFiscalProfile",
      "description": "Perfil fiscal del restaurante aislado por inquilino"
    },
    "/users/{userId}/empleados/{empleadoId}": {
      "schema": "#/entities/Empleado",
      "description": "Colección única sincronizada de empleados, roles y perfiles POS del restaurante"
    },
    "/users/{userId}/mesas/{tableId}": {
      "schema": "#/entities/Table",
      "description": "Colección aislada de mesas del usuario"
    },
    "/users/{userId}/menu/{menuId}": {
      "schema": "#/entities/Product",
      "description": "Colección aislada del menú del usuario"
    },
    "/users/{userId}/productos/{productId}": {
      "schema": "#/entities/Product",
      "description": "Colección aislada de productos del usuario"
    },
    "/users/{userId}/inventario/{itemId}": {
      "schema": "#/entities/PerishableItem",
      "description": "Colección aislada de inventario/insumos del usuario"
    },
    "/users/{userId}/despensa/{itemId}": {
      "schema": "#/entities/PerishableItem",
      "description": "Colección de compatibilidad para inventario de despensa del usuario"
    },
    "/users/{userId}/proveedores/{proveedorId}": {
      "schema": "#/entities/Supplier",
      "description": "Colección aislada de proveedores de insumos del usuario"
    },
    "/users/{userId}/ordenes_proveedores/{ordenId}": {
      "schema": "#/entities/SupplierOrder",
      "description": "Registro histórico de pedidos realizados a distribuidores y su confirmación de entrega"
    },
    "/users/{userId}/pedidos/{pedidoId}": {
      "schema": "#/entities/SaleReceipt",
      "description": "Colección aislada de pedidos activos e históricos del usuario"
    },
    "/users/{userId}/ventas/{saleId}": {
      "schema": "#/entities/SaleReceipt",
      "description": "Colección aislada e inmutable de ventas contables del usuario"
    },
    "/users/{userId}/ventas_metadatos/{saleId}": {
      "schema": "#/entities/SaleBillingMetadata",
      "description": "Metadatos de facturación electrónica y exportación contable por venta"
    },
    "/users/{userId}/pagos_mesa/{paymentId}": {
      "schema": "#/entities/TablePaymentRecord",
      "description": "Libro mayor idempotente de pagos parciales y mixtos de mesa"
    },
    "/users/{userId}/facturacion_privada_qr/{recordId}": {
      "schema": "#/entities/PrivateQrBillingRecord",
      "description": "Buzón privado de datos fiscales PII enviados desde QR; legible solo por el restaurante propietario"
    }
  }
}
